# ============ FitDeveloper (two-variant repo) ============

# ---- logs & local junk ----
*.log
server.pid
probe*.js
_start_cg.bat

# ---- build artifacts & zips ----
*.zip
build/
.gradle/
plugin/.intellijPlatform/

# ---- IDE ----
.idea/
*.iml

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Node (standalone variant) ----
node_modules/

# ---- self-signed certs (without-plugin variant) ----
# GitHub push-protection rejects private keys, and the cert is regenerable:
# run without-plugin/gen_cert.bat (Windows) or gen_cert.sh (macOS/Linux/Git Bash)
# after a fresh clone. Android walkers work without certs; iOS needs them.
without-plugin/cert.pem
without-plugin/key.pem
# keystore backups - rekey artifacts, never publish key material copies 
plugin/src/main/resources/cert/*.bak-* 
